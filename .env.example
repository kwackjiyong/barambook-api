# 로컬 개발용 환경변수 예시. 값을 채워서 .env 로 복사한다.
#   cp .env.example .env
# app.module.ts·lite-app.module.ts 의 dotenv.config() 는 .env 만 읽는다.
# .env.local 은 읽지 않으므로 그 이름으로 두면 아무것도 적용되지 않는다.

# --- MongoDB ---
# 비워 두면 전체 AppModule 이 named 연결(barambookConnection)을 만들지 않아
# @InjectModel(..., 'barambook') 주입이 전부 실패한다. LiteAppModule 은 'barambook' 으로 기본값을 쓴다.
MONGO_CONNECTIONNAME=barambook
MONGO_URL=mongodb://localhost:27017/info?authSource=admin
MONGO_USERNAME=
MONGO_PASSWORD=

# --- 서버 ---
# API_MODE=lite 면 LiteAppModule 로 뜨고 BARAMVISION_* 를, 아니면 AppModule 로 뜨고 PORT·HOST 를 쓴다.
API_MODE=
PORT=3010
HOST=0.0.0.0
BARAMVISION_PORT=43110
BARAMVISION_HOST=127.0.0.1
NODE_ENV=
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGIN_HOSTS=
TRUSTED_PROXY_HOPS=

# --- 소셜 로그인 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=

# --- 비밀값 ---
# UPSERT_SECRET 은 환경변수가 아니다. src/ranking/ranking.controller.ts 에 하드코딩돼 있어서
# 여기에 넣어도 적용되지 않는다.
HOPAE_TOKEN_SECRET=
CHAT_SCAN_API_KEY=
MSW_ANALYTICS_KEY=
OPERATOR_ACCOUNTS=

# --- 웹푸시 ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- 경로·CDN ---
CDN_URL=
CHAR_MS_CDN_ROOT=
CHANNEL_CAMPFIRE_DIR=
OLD_BARAM_ITEM_NAMES_PATH=
OLD_BARAM_OBP_PATH=

# --- 플레이 기록 로컬 대시보드 (tools/msw-dashboard) ---
# server.mjs 는 dotenv 를 읽지 않으니 쉘 환경변수로 줘야 한다. 비우면 운영 API 를 본다.
# 키는 MSW_ANALYTICS_KEY 나 tools/msw-dashboard/.key 파일에서 읽는다.
MSW_ANALYTICS_BASE=
